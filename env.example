# Reown Project ID - Get this from https://cloud.reown.com
VITE_REOWN_PROJECT_ID=your_project_id_here

# Optional: override the Rift API base (default https://payment.riftfi.xyz).
# Use https://sandbox.riftfi.com for a sandbox build. `?env=sandbox` also works at runtime.
# VITE_API_BASE_URL=
# VITE_SANDBOX_API_BASE_URL=
